# Copier ce fichier en ".env" puis remplir les valeurs. Le fichier .env ne doit JAMAIS être envoyé sur Git.

# --- Base de données PostgreSQL ---
DB_NAME=immosenegal
DB_USER=immosenegal
DB_PASSWORD=choisir_un_mot_de_passe_solide
DB_URL=jdbc:postgresql://localhost:5432/immosenegal

# --- Backend ---
PORT=8080
# Origines autorisées à appeler l'API (URL du frontend), séparées par des virgules.
CORS_ALLOWED_ORIGINS=http://localhost:5173
