# Copier ce fichier en ".env" puis remplir les valeurs. Le fichier .env ne doit JAMAIS être envoyé sur Git.

# --- Base de données PostgreSQL ---
DB_NAME=immosenegal
DB_USER=immosenegal
DB_PASSWORD=choisir_un_mot_de_passe_solide
DB_URL=jdbc:postgresql://localhost:5432/immosenegal

# --- Sécurité (obligatoire) ---
# Clé de signature des jetons JWT, 32 caractères minimum. Générer avec : openssl rand -base64 48
JWT_SECRET=
# Durée de vie du jeton d'accès, en minutes (15 par défaut).
JWT_ACCESS_TTL_MINUTES=15

# --- Premier administrateur (optionnel, UNIQUEMENT pour le tout premier démarrage) ---
# Renseigner les deux, démarrer une fois, puis SUPPRIMER ces deux lignes. Mot de passe : 12 caractères minimum.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Backend ---
PORT=8080
# Origines autorisées à appeler l'API (URL du frontend), séparées par des virgules.
CORS_ALLOWED_ORIGINS=http://localhost:5173
